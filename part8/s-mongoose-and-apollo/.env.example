# ⭐ .env.example — part8s 环境变量模板(无真实密码)
#
# ⭐ 关键诚实声明:
#   - 本文件**不**是 .env(真实配置),只是占位模板
#   - .env 已被 .gitignore 排除,用户需要自己 cp .env.example .env 然后改值
#   - 本项目**从不**提交真实 MONGODB_URI(避免泄露 Atlas 密码)
#
# ⭐ 使用步骤:
#   1. cp .env.example .env
#   2. 编辑 .env,把下面占位值替换成你自己的:
#      - MONGODB_URI:Atlas 集群 URI 或本地 mongodb://localhost:27017/phonebook
#      - PORT:可选,默认 4000
#   3. node index.js 启动(per package.json scripts.dev)

# ⭐⭐⭐ MONGODB_URI — 数据库连接字符串 ⭐⭐⭐
#
# MongoDB Atlas 示例:
#   mongodb+srv://USERNAME:PASSWORD@cluster0.abcde.mongodb.net/phonebook
#   - USERNAME:Atlas 数据库用户
#   - PASSWORD:用户密码(< > 需要 URL encode: %3C %3E)
#   - cluster0.abcde.mongodb.net:Atlas 集群地址
#   - phonebook:database 名
#
# 本地 MongoDB 示例:
#   mongodb://localhost:27017/phonebook
#   - 需要本地启动 mongod 服务
#   - 默认端口 27017
#   - phonebook:database 名
#
# 课程原文(per course line 71):"The value of MONGODB_URI is obtained from an
# environment variable, so you need to add an appropriate value for it to the
# _.env_ file in the same way as in part 3"
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.abcde.mongodb.net/phonebook

# ⭐⭐⭐ PORT — Apollo Server 端口(part8r 沿用)⭐⭐⭐
#
# 课程原文(per course line 187):"If the PORT environment variable is not found,
# the default port 4000 is used—which is also the port the frontend currently
# expects the server to be running on."
# - 不写 PORT → fallback 到 4000(per index.js 的 `process.env.PORT || 4000`)
# - 写 PORT=4001 → server 监听 4001(frontend 需要相应改 fetch URL)
PORT=4000